# Required for live runs (not needed for --dry-run)
ANTHROPIC_API_KEY=

# Model and search budget
MW_MODEL=claude-opus-5-5
MW_MAX_SEARCHES=8
MW_WINDOW_HOURS=48

# Where dedup memory and run history live
MW_DB_PATH=data/market_watch.db

# Delivery (all optional; with none set, the brief prints to stdout)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# Optional cost tracking, USD per million tokens and per 1,000 searches.
# Fill in from the current Anthropic pricing page; left blank, only token counts are logged.
MW_PRICE_INPUT_PER_MTOK=
MW_PRICE_OUTPUT_PER_MTOK=
MW_PRICE_SEARCH_PER_1K=
